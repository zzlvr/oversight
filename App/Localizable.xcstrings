      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API-ключ"
          }
        }
      }
    },
    "Could not save the key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить ключ"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык"
          }
        }
