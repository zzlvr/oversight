      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель"
          }
        }
      }
    },
    "Prompt": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промт"
          }
        }
      }
    },
    "Prompt presets": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заготовки промтов"
          }
        }
      }
    },
    "Prompts": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промты"
          }
        }
      }
    },
    "Provider": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системный"
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название"
          }
        }
      }
    },
    "Screen broadcast": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансляция экрана"
          }
        }
      }
    },
    "Receiving the screen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран получен"
          }
        }
      }
    },
    "Cannot receive frames. Reopen the app": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся принимать кадры. Откройте приложение заново"
          }
        }
      }
    },
    "Floating window": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавающее окно"
          }
        }
      }
    },
    "Answer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ"
          }
        }
      }
    },
    "Instructions for the AI": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструкции для ИИ"
          }
        }
      }
    },
    "Thinking…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Думаю…"
          }
        }
      }
    },
    "Add your API key in Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте API-ключ в настройках"
          }
        }
      }
    },
    "No screen captured yet. Start the broadcast": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран ещё не получен. Начните трансляцию и откройте другое приложение"
          }
        }
      }
    },
    "The request timed out. Try again": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания истекло. Попробуйте ещё раз"
          }
        }
      }
    },
    "The AI returned an empty answer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ вернул пустой ответ"
          }
        }
      }
    },
    "Still working on the last question": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё обрабатываю прошлый вопрос"
          }
        }
      }
    },
    "Invalid API key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный API-ключ"
          }
        }
      }
    },
    "No network connection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к сети"
          }
        }
      }
    },
    "The AI service returned an error": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис ИИ вернул ошибку"
          }
        }
      }
    },
    "Get ready": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка"
          }
        }
      }
    },
    "Saved": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранён"
          }
        }
      }
    },
    "Tap to add your key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы добавить ключ"
          }
        }
      }
    },
    "Tap the red button to start": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите красную кнопку"
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть"
          }
        }
      }
    },
    "Answers appear in it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В нём появляются ответы"
          }
        }
      }
    },
    "Ask about a screen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросить про экран"
          }
        }
      }
    },
    "Open the app you need help with, wait a few seconds, then come back here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение, с которым нужна помощь, подождите пару секунд и вернитесь сюда."
          }
        }
      }
    },
    "What do you want to know?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы хотите узнать?"
          }
        }
      }
    },
    "Send": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить"
          }
        }
      }
    },
    "While you are in another app": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы в другом приложении"
          }
        }
      }
    },
    "Pause in the floating window runs your first preset": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза в плавающем окне запускает первую заготовку"
          }
        }
      }
    },
    "The skip buttons turn pages of a long answer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки перемотки листают длинный ответ"
          }
        }
      }
    },
    "Your key is stored in the iOS Keychain on this device only. Leave Model empty to use the inexpensive default.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ хранится только в Keychain на этом устройстве. Оставьте модель пустой, чтобы использовать недорогую по умолчанию."
          }
        }
      }
    },
    "The first preset is the one the floating window runs.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавающее окно запускает первую заготовку."
          }
        }
      }
    },
    "No prompt presets. Add one in Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет заготовок. Добавьте в настройках"
          }
        }
      }
    },
    "Translate screen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевести экран"
          }
        }
      }
    },
    "Where do I tap?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда нажать?"
          }
        }
      }
    },
    "Is this a good deal?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это выгодно?"
          }
        }
      }
    }
  },
  "version": "1.0"
}
