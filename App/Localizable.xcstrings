{
  "sourceLanguage": "en",
  "strings": {
    "Add preset": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить заготовку"
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API-ключ"
          }
        }
      }
    },
    "Could not save the key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить ключ"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель"
          }
        }
      }
    },
    "Prompt": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промт"
          }
        }
      }
    },
    "Prompt presets": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заготовки промтов"
          }
        }
      }
    },
    "Prompts": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промты"
          }
        }
      }
    },
    "Provider": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системный"
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название"
          }
        }
      }
    },
    "Screen broadcast": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансляция экрана"
          }
        }
      }
    },
    "Receiving the screen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран получен"
          }
        }
      }
    },
    "Cannot receive frames. Reopen the app": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся принимать кадры. Откройте приложение заново"
          }
        }
      }
    },
    "Floating window": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавающее окно"
          }
        }
      }
    },
    "Answer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ"
          }
        }
      }
    },
    "Instructions for the AI": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструкции для ИИ"
          }
        }
      }
    },
    "Thinking…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Думаю…"
          }
        }
      }
    },
    "Add your API key in Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте API-ключ в настройках"
          }
        }
      }
    },
    "No screen captured yet. Start the broadcast": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран ещё не получен. Начните трансляцию и откройте другое приложение"
          }
        }
      }
    },
    "The request timed out. Try again": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания истекло. Попробуйте ещё раз"
          }
        }
      }
    },
    "The AI returned an empty answer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ вернул пустой ответ"
          }
        }
      }
    },
    "Still working on the last question": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё обрабатываю прошлый вопрос"
          }
        }
      }
    },
    "Invalid API key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный API-ключ"
          }
        }
      }
    },
    "No network connection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к сети"
          }
        }
      }
    },
    "The AI service returned an error": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис ИИ вернул ошибку"
          }
        }
      }
    },
    "Saved": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранён"
          }
        }
      }
    },
    "Tap to add your key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы добавить ключ"
          }
        }
      }
    },
    "Tap the red button to start": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите красную кнопку"
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть"
          }
        }
      }
    },
    "Answers appear in it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В нём появляются ответы"
          }
        }
      }
    },
    "What do you want to know?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы хотите узнать?"
          }
        }
      }
    },
    "Send": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить"
          }
        }
      }
    },
    "The first preset is the one the floating window runs.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавающее окно запускает первую заготовку."
          }
        }
      }
    },
    "No prompt presets. Add one in Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет заготовок. Добавьте в настройках"
          }
        }
      }
    },
    "Translate screen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевести экран"
          }
        }
      }
    },
    "Where do I tap?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда нажать?"
          }
        }
      }
    },
    "Is this a good deal?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это выгодно?"
          }
        }
      }
    },
    "Get a free API key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получить бесплатный API-ключ"
          }
        }
      }
    },
    "Get an API key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получить API-ключ"
          }
        }
      }
    },
    "Open the key page, sign in, create a key and paste it here. Your key is stored in the iOS Keychain on this device only. Leave Model empty to use the inexpensive default.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте страницу ключа, войдите, создайте ключ и вставьте его сюда. Ключ хранится только в Keychain на этом устройстве. Оставьте модель пустой, чтобы использовать недорогую по умолчанию."
          }
        }
      }
    },
    "On Gemini's free tier, Google may use what you send to improve its products, and people may read it. Do not ask while private information is on the screen. You must be 18 or older.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На бесплатном тарифе Gemini Google может использовать присланное для улучшения своих продуктов, и это могут читать люди. Не спрашивайте, пока на экране личные данные. Вам должно быть не меньше 18 лет."
          }
        }
      }
    },
    "Get set up": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка"
          }
        }
      }
    },
    "Ready": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё готово"
          }
        }
      }
    },
    "Open any app and press pause in the floating window.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте любое приложение и нажмите паузу в плавающем окне."
          }
        }
      }
    },
    "Screen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран"
          }
        }
      }
    },
    "Ask about this screen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите про этот экран"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копировать"
          }
        }
      }
    },
    "Welcome to Oversight": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в Oversight"
          }
        }
      }
    },
    "Add your API key. Gemini has a free tier.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте API-ключ. У Gemini есть бесплатный тариф."
          }
        }
      }
    },
    "Start the screen broadcast. Nothing is sent until you ask.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните трансляцию экрана. Ничего не отправляется, пока вы не спросите."
          }
        }
      }
    },
    "Open the floating window and switch to any app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте плавающее окно и перейдите в любое приложение."
          }
        }
      }
    },
    "When you ask, one screenshot goes to the AI provider you chose.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы спрашиваете, один скриншот уходит выбранному провайдеру ИИ."
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Screen saved. Open Oversight to ask about it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран сохранён. Откройте Oversight, чтобы спросить о нём"
          }
        }
      }
    },
    "In another app, press −10 in the floating window to save the screen, or pause to ask right away. It appears here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В другом приложении нажмите −10 в плавающем окне, чтобы сохранить экран, или паузу, чтобы сразу спросить. Он появится здесь."
          }
        }
      }
    },
    "An assistant that sees your screen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощник, который видит ваш экран"
          }
        }
      }
    }
  },
  "version": "1.0"
}
